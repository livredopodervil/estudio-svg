gil timeline 0.1 {
// GIL3 legado (arte), objetos genéricos e matemática do SpatialSeed.
stage {"width":960,"height":540,"duration":30,"background":"#08142b","camera":"cam"}
resource camera camera {"fov":44,"z":13}
resource sun light.directional {"x":-4,"y":5,"z":7,"intensity":1}
resource group group {}
resource box mesh.box {"size":1.2,"color":"#70b5ec","layer":1}
resource core mesh.box {"size":2.1,"color":"#f5c461","layer":1}
resource dot shape.circle {"size":0.16,"color":"#80dbd5","layer":2}
resource label text {"text":"","fontSize":28,"color":"#d7ecff","layer":4}
resource legacy image.svg {"asset":"helix.svg","size":3.2,"layer":3}
resource snow image.svg {"asset":"snowflake.svg","size":2.2,"layer":3}
resource blackout overlay.fade {"color":"#08142b","layer":20,"opacity":0}
resource beep audio.tone {"frequency":500,"gain":0.1,"wave":"triangle"}
resource bass audio.tone {"frequency":98,"gain":0.028,"wave":"sine"}
resource telemetry arbitrary.telemetry {"measurement":0,"unit":"rpm"}
object cam camera - {}
object keylight sun - {}
object system group - {"x":1.5,"rx":17}
object nucleus core system {}
repeat satellite box system 10 {"x":{"expr":"3.1*cos(tau*(i-1)/count)"},"z":{"expr":"3.1*sin(tau*(i-1)/count)"},"ry":{"expr":"36*i"},"sx":0.46,"sy":0.46,"sz":0.46}
object ornament legacy - {"x":-4.7,"y":0.15}
object crystal snow - {"x":-4.7,"y":0.15,"opacity":0}
object orbit2d group - {"x":-4.7,"y":0.15}
repeat marker dot orbit2d 14 {"x":{"expr":"1.8*cos(tau*i/count)"},"y":{"expr":"1.8*sin(tau*i/count)"}}
object title label - {"text":"GIL • SPATIALSEED","y":3.25,"fontSize":34}
object subtitle label - {"text":"Geometria, hierarquia, câmera e tempo","y":-3.25,"fontSize":22,"color":"#a4c6dc"}
object caption label - {"text":"GIL3 original","x":-4.7,"y":-2.05,"fontSize":18}
object caption2 label - {"text":"Instâncias 3D","x":2.6,"y":-2.65,"fontSize":18}
object transition blackout - {}
object tone beep - {}
object backgroundTone bass - {}
object reading telemetry - {}
animate system ry {"expr":"t*24"}
animate system rx {"expr":"17+11*sin(t*0.8)"}
animate nucleus rz {"expr":"t*47"}
animate satellite_1 y {"expr":"0.65*sin(t*3)"}
animate satellite_4 y {"expr":"0.9*cos(t*2.3)"}
animate satellite_7 y {"expr":"0.8*sin(t*2.6)"}
animate ornament rz {"expr":"t*52"}
animate ornament opacity {"keys":[[0,1],[12,1],[16,0],[30,0]],"ease":"smooth"}
animate crystal opacity {"keys":[[0,0],[12,0],[16,1],[30,1]],"ease":"smooth"}
animate crystal rz {"expr":"-t*22"}
animate orbit2d rz {"expr":"-t*22"}
animate cam x {"expr":"0.75*sin(t*0.43)"}
animate cam ry {"expr":"3*sin(t*0.43)"}
animate cam z {"keys":[[0,14],[9,11.5],[16,14],[23,10.8],[30,14]],"ease":"smooth"}
animate keylight intensity {"expr":"0.9+0.18*sin(t)"}
animate transition opacity {"keys":[[0,1],[1.7,0],[13.5,0],[15,0.8],[16.5,0],[28,0],[30,1]],"ease":"smooth"}
animate caption opacity {"keys":[[0,1],[13,1],[16,0],[30,0]],"ease":"smooth"}
animate reading measurement {"expr":"120+30*sin(t)"}
cue tone {"start":1.7,"duration":0.22}
cue tone {"start":5,"duration":0.12}
cue tone {"start":10,"duration":0.14}
cue tone {"start":15,"duration":0.35}
cue tone {"start":20,"duration":0.14}
cue tone {"start":25,"duration":0.16}
cue backgroundTone {"start":1.7,"duration":10.3}
cue backgroundTone {"start":16,"duration":12}
}

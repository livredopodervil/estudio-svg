{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estúdio SVG 2.2 — projeto audiovisual",
  "description": "Estúdio SVG V2.3: vozes online e offline, prévias de cenas; compatível com V2.2.",
  "type": "object",
  "required": [
    "titulo",
    "cenas"
  ],
  "properties": {
    "versao": {
      "type": "string"
    },
    "titulo": {
      "type": "string",
      "maxLength": 180
    },
    "video": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 1920,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 1920,
          "multipleOf": 2
        },
        "fps": {
          "enum": [
            24,
            25,
            30
          ]
        },
        "draw_fps": {
          "enum": [
            1,
            2,
            3,
            4,
            6,
            8,
            10,
            12,
            15,
            24
          ]
        },
        "background": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "voz": {
      "type": "string"
    },
    "velocidade_voz": {
      "type": "string"
    },
    "encaixe_voz": {
      "enum": [
        "estender",
        "avisar"
      ]
    },
    "trilha": {
      "type": "string"
    },
    "volume_musica": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "volume_voz": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "cenas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "motor_voz": {
      "type": "string",
      "enum": [
        "edge-tts",
        "espeak-ng",
        "piper"
      ],
      "description": "Motor de síntese para MP4"
    },
    "modelo_piper": {
      "type": "string",
      "description": "Modelo .onnx em modelos/ para voz neural offline"
    },
    "voz_espeak": {
      "type": "string",
      "description": "Voz local do eSpeak NG; pt-br"
    },
    "velocidade_espeak": {
      "type": "integer",
      "minimum": 80,
      "maximum": 260
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "scene": {
      "type": "object",
      "required": [
        "tipo",
        "duracao",
        "titulo"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tipo": {
          "enum": [
            "globo",
            "linha",
            "barras",
            "numero",
            "cartoes",
            "arvore",
            "svg",
            "foto"
          ]
        },
        "duracao": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 600
        },
        "titulo": {
          "type": "string"
        },
        "subtitulo": {
          "type": "string"
        },
        "fonte": {
          "type": "string"
        },
        "categoria": {
          "type": "string"
        },
        "movimento": {
          "enum": [
            "suave",
            "linear",
            "entrada",
            "saida"
          ]
        },
        "dados": {
          "type": "array"
        },
        "itens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valor": {},
        "unidade": {
          "type": "string"
        },
        "sufixo": {
          "type": "string"
        },
        "destaque": {
          "type": "string"
        },
        "svg": {
          "type": "string"
        },
        "cores": {
          "type": "object",
          "properties": {
            "fundo": {
              "$ref": "#/$defs/color"
            },
            "destaque": {
              "$ref": "#/$defs/color"
            },
            "texto": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "imagem": {
          "type": "object",
          "properties": {
            "arquivo": {
              "type": "string"
            },
            "fit": {
              "enum": [
                "contain",
                "cover",
                "pad",
                "stretch",
                "crop"
              ]
            },
            "align_x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "align_y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bg": {
              "$ref": "#/$defs/color"
            },
            "crop": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "audio": {
          "$ref": "#/$defs/audio"
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voice_enabled": {
          "type": "boolean"
        },
        "voice_text": {
          "type": "string"
        },
        "voice_file": {
          "type": "string"
        },
        "voice_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "voice_delay": {
          "type": "number",
          "minimum": 0
        },
        "music_file": {
          "type": "string"
        },
        "music_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "duck_music": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "fade_in": {
                "type": "number",
                "minimum": 0
              },
              "fade_out": {
                "type": "number",
                "minimum": 0
              },
              "loop": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}